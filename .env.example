# 复制为 .env 后填入。.env 已被 git 忽略。

# 默认 provider: deepseek | claude | openai_compat
CABINET_DEFAULT_PROVIDER=deepseek

# --- DeepSeek（默认，中文/古文强、圆桌多次调用成本低）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.5
DEEPSEEK_MAX_TOKENS=2200

# --- Claude（高 stakes 决策一键切换，需 pip install '.[claude]'）---
ANTHROPIC_API_KEY=
CABINET_CLAUDE_MODEL=claude-opus-4-8
# Opus 4.8 要求使用默认 temperature；这个参数对兼容模型才生效。
CABINET_CLAUDE_TEMPERATURE=

# --- OpenAI 兼容（如通义千问 DashScope；预留）---
CABINET_OPENAI_BASE_URL=
CABINET_OPENAI_API_KEY=
CABINET_OPENAI_MODEL=

# --- 对外开放 API 鉴权（/api/v1/*，留空则对外接口关闭）---
CABINET_EXTERNAL_API_KEY=

# --- 私有 UI API（/api/*）远程访问密钥 ---
# 未设置时只接受本机 loopback；经反向代理或局域网访问时必须设置。
CABINET_UI_API_KEY=
# 逗号分隔的额外前端 Origin；默认只信任 localhost/127.0.0.1:5173。
# 远程 UI 还必须同时配置 CABINET_UI_API_KEY 与 HTTPS。
CABINET_UI_ORIGINS=
